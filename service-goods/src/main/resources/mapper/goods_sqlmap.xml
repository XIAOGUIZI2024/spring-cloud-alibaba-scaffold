<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.hollis.nft.turbo.goods.infrastructure.mapper.GoodsMapper">
    <resultMap id="BaseResultMap" type="cn.hollis.nft.turbo.goods.domain.entity.Goods">
        <result property="id" column="ID"/>
        <result property="gmtCreate" column="GMT_CREATE"/>
        <result property="gmtModified" column="GMT_MODIFIED"/>
        <result property="goodsId" column="GOODS_ID"/>
        <result property="goodsName" column="GOODS_NAME"/>
        <result property="goodsType" column="GOODS_TYPE"/>
        <result property="state" column="STATE"/>
        <result property="price" column="PRICE"/>
        <result property="inventory" column="INVENTORY"/>
        <result property="lockedInventory" column="LOCKED_INVENTORY"/>
        <result property="coverUrl" column="COVER_URL"/>
        <result property="saleTime" column="SALE_TIME"/>
        <result property="color" column="COLOR"/>
        <result property="origin" column="ORIGIN"/>
        <result property="shape" column="SHAPE"/>
        <result property="transparency" column="TRANSPARENCY"/>
        <result property="variety" column="VARIETY"/>
        <result property="deleted" column="DELETED"/>
        <result property="lockVersion" column="LOCK_VERSION"/>
    </resultMap>

    <select id="findByGoodsId" resultMap="BaseResultMap">
        SELECT * FROM goods WHERE deleted = 0
        <if test="goodsId != null">AND goods_id = #{goodsId}</if>
    </select>

    <update id="updateByGoodsId">
        UPDATE goods
        SET gmt_modified = NOW()
        <if test="goods.goodsName != null">, goods_name = #{goods.goodsName}</if>
        <if test="goods.goodsType != null">, goods_type = #{goods.goodsType}</if>
        <if test="goods.state != null">, state = #{goods.state}</if>
        <if test="goods.price != null">, price = #{goods.price}</if>
        <if test="goods.inventory != null">, inventory = #{goods.inventory}</if>
        <if test="goods.coverUrl != null">, cover_url = #{goods.coverUrl}</if>
        <if test="goods.saleTime != null">, sale_time = #{goods.saleTime}</if>
        <if test="goods.color != null">, color = #{goods.color}</if>
        <if test="goods.origin != null">, origin = #{goods.origin}</if>
        <if test="goods.shape != null">, shape = #{goods.shape}</if>
        <if test="goods.transparency != null">, transparency = #{goods.transparency}</if>
        <if test="goods.variety != null">, variety = #{goods.variety}</if>
        WHERE goods_id = #{goods.goodsId} AND deleted = 0
    </update>

    <update id="deleteByGoodsId">
        UPDATE goods SET deleted = 1, gmt_modified = NOW() WHERE goods_id = #{goodsId}
    </update>

    <!-- TODO: 添加更多 SQL（分页查询、库存扣减、上下架等） -->
</mapper>
